# Copy to .env and fill in. Never commit .env.

# RPC endpoint for Sepolia (e.g. from Alchemy or Infura)
SEPOLIA_RPC_URL=

# Deployer key. Prefer a Foundry keystore reference over a raw private key;
# if using a raw key, it must only ever hold Sepolia test ETH.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key, for contract verification (used by `make deploy`)
ETHERSCAN_API_KEY=

# Pinata JWT, for pinning the image + metadata JSON to IPFS (`make upload`)
PINATA_JWT=

# Filled in after `make deploy` prints the deployed address
NFT_CONTRACT_ADDRESS=

# Filled in after `make upload` prints the metadata ipfs:// URI
TOKEN_URI=

# Optional: who receives the mint. Defaults to the deployer's own address.
MINT_RECIPIENT=

# Optional: metadata fields used by `make upload`, defaults shown
NFT_TITLE=s42t
ARTIST_LOGIN=mcatalan

# --- Bonus: mint website (bonus/, `make bonus`) ---

# Host port Caddy exposes the site on
BONUS_PORT=8080

# CID of the artwork the website mints against — reuses the image already
# pinned by `make upload` (see mint/assets/artwork.svg) rather than
# accepting uploads; set this to the image CID `make upload` printed.
BONUS_IMAGE_CID=

